---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "The Medication Audit Kit — A Free Download · The Geriatrician's Guide";
const description = "Two printable tools for reviewing a loved one's medications — the Medication Audit and the Medication List. The review a geriatrician runs with every new patient.";
---
<BaseLayout title={title} description={description}>
  <div class="wrap section tk" data-screen-label="Medication Audit Kit landing">

    <p class="eyebrow">Free Download</p>
    <h1>The Medication<br />Audit Kit</h1>
    <div class="tk__rule"></div>

    <div class="tk__lede">
      <p>Nothing has to be wrong for a medication to stop being appropriate. Bodies change, and a prescription started for a good reason years ago can outlast its purpose.</p>
    </div>
    <p class="tk__body">The Medication Audit Kit is the review I run with every new patient, set down so you can run it too. Two printable tools: the Audit, which walks through the questions worth asking of every medication, and the List, which keeps every prescription, over-the-counter drug, and supplement in one place. Bring both to a medication review, a doctor&rsquo;s visit, or a care plan meeting.</p>

    <p class="tk__pieces-label">What&rsquo;s in the Kit</p>
    <div class="tk__pieces">
      <div class="tk__piece tk__piece--terra">
        <span class="tk__piece-num">1</span>
        <div>
          <div class="tk__piece-name">The Medication Audit</div>
          <p class="tk__piece-desc">The nine-step review I run with every new patient. It starts with one complete medication list, then checks who&rsquo;s managing it, what&rsquo;s on the Beers Criteria, and whether what&rsquo;s actually given matches what was ordered. It ends with how often to run it again.</p>
        </div>
      </div>
      <div class="tk__piece tk__piece--gold">
        <span class="tk__piece-num">2</span>
        <div>
          <div class="tk__piece-name">The Medication List</div>
          <p class="tk__piece-desc">One current record of every medication, dose, and prescriber, plus allergies and intolerances. Fill it out, update it whenever something changes, and bring it to every appointment.</p>
        </div>
      </div>
    </div>

    <div class="tk__form-wrap">
      <div class="tk__form-rule"></div>
      <div class="tk__form-inner">
        <p class="tk__form-label">Get the free Medication Audit Kit.</p>
        <p class="tk__form-sub">Enter your email to download both printable tools right away. Confirm your email and the links will be in your inbox too.<br />No spam, no placement calls. Unsubscribe anytime.</p>

        <!-- Kit form 9964133 (Medication Audit Kit). Tag medication-audit-lead. On success the page
             redirects to /medication-audit/thanks, where the downloads live. Kit's own embed
             and success message aren't used. -->
        <form class="email-form email-form--dark" id="tk-form" action="https://app.kit.com/forms/9964133/subscriptions" method="post">
          <input type="email" name="email_address" placeholder="you@email.com" aria-label="Email address" required />
          <button type="submit">Send me the Kit</button>
        </form>
        <p class="tk__fine">We never sell your personal information.</p>
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  const f = document.getElementById('tk-form') as HTMLFormElement | null;
  if (f) f.addEventListener('submit', (e) => {
    e.preventDefault();
    (window as any).ggKitSubmit(f, () => { window.location.href = '/medication-audit/thanks'; });
  });
</script>

<style>
  .tk { max-width: 800px; }
  .tk .eyebrow { font-size: 12.5px; letter-spacing: 0.18em; }
  .tk h1 {
    font-family: var(--font-serif); font-weight: 500;
    font-size: clamp(44px, 8vw, 68px); line-height: 1.0; letter-spacing: -0.02em;
    color: var(--ink); margin-top: 14px;
  }
  .tk__rule { width: 96px; height: var(--rule-terra); background: var(--terra); margin: 26px 0 0; }
  .tk__lede p {
    font-family: var(--font-serif); font-style: italic; font-weight: 400;
    font-size: clamp(20px, 2.6vw, 24px); line-height: 1.55; color: var(--ink);
    margin-top: 28px; text-wrap: pretty;
  }
  .tk__body {
    font-family: var(--font-sans); font-weight: 400; font-size: 17px; color: var(--ink);
    line-height: 1.75; margin-top: 16px; text-wrap: pretty;
  }
  .tk__pieces-label {
    font-family: var(--font-sans); font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.16em; font-size: 13px; color: var(--terra);
    display: flex; align-items: center; gap: 16px; margin: 28px 0 20px;
  }
  .tk__pieces-label::after { content: ""; flex: 1; height: 1px; background: var(--hairline); }
  .tk__pieces { display: flex; flex-direction: column; gap: 16px; }
  .tk__piece {
    display: grid; grid-template-columns: 44px 1fr; gap: 22px; align-items: center;
    background: var(--paper); border: 1px solid var(--hairline); border-left: 3px solid var(--golden);
    border-radius: 0 var(--radius) var(--radius) 0; padding: 22px 26px;
    box-shadow: var(--shadow-card); transition: box-shadow .18s ease;
  }
  .tk__piece--terra { border-left-color: var(--terra); background: var(--terra-tint); }
  .tk__piece--gold { border-left-color: var(--golden); background: rgba(196,150,42,0.07); }
  .tk__piece--midnight { border-left-color: var(--midnight); background: var(--midnight-tint); }
  .tk__piece-num {
    width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-family: var(--font-serif); font-weight: 500; font-size: 19px; color: var(--paper);
  }
  .tk__piece--terra .tk__piece-num { background: var(--terra); }
  .tk__piece--gold .tk__piece-num { background: var(--golden); }
  .tk__piece--midnight .tk__piece-num { background: var(--midnight); }
  .tk__piece-name { font-family: var(--font-serif); font-weight: 500; font-size: 21px; color: var(--ink); letter-spacing: -0.01em; }
  .tk__piece-desc { font-family: var(--font-sans); font-weight: 400; font-size: 15px; color: var(--muted); line-height: 1.7; margin-top: 6px; text-wrap: pretty; }
  /* Form — signature device: Terracotta rule -> Midnight field -> Fog text */
  .tk__form-wrap {
    margin-top: 56px; border-radius: var(--radius); overflow: hidden;
    box-shadow: 0 4px 40px rgba(0,0,0,0.18);
  }
  .tk__form-rule { height: var(--rule-terra); background: var(--terra); }
  .tk__form-inner { background: var(--midnight); padding: clamp(36px,5vw,52px) clamp(28px,5vw,52px); }
  .tk__form-label { font-family: var(--font-serif); font-weight: 500; font-size: clamp(24px, 3vw, 30px); color: var(--on-dark); margin-bottom: 10px; letter-spacing: -0.01em; }
  .tk__form-sub { font-family: var(--font-sans); font-weight: 300; font-size: 16px; color: rgba(245,240,230,0.68); line-height: 1.6; margin-bottom: 26px; text-wrap: pretty; max-width: 480px; }
  .tk__fine { font-family: var(--font-sans); font-weight: 300; font-size: 13px; color: rgba(245,240,230,0.5); margin-top: 10px; }
  .tk__dl-sub-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: 22px; }
  .tk__dl-sub { font-family: var(--font-sans); font-weight: 400; font-size: 17px; color: var(--ink); line-height: 1.8; text-wrap: pretty; margin: 0; flex: 1; min-width: 240px; }
  .tk__dl-all {
    flex: none; display: inline-flex; align-items: center; gap: 8px;
    background: transparent; border: 1.5px solid var(--midnight); border-radius: var(--radius);
    padding: 11px 18px; cursor: pointer; white-space: nowrap;
    font-family: var(--font-sans); font-weight: 600; font-size: 14px; color: var(--midnight);
    transition: background .15s ease, color .15s ease;
  }
  .tk__dl-all:hover { background: var(--midnight); color: var(--paper); }
  .tk__dl-all svg { display: block; }
  .tk__downloads { display: flex; flex-direction: column; gap: 12px; }
  .tk__dl {
    display: grid; grid-template-columns: 44px 1fr auto; gap: 20px; align-items: center;
    background: var(--paper); border: 1px solid var(--hairline);
    outline: 1.5px solid transparent; outline-offset: -2px;
    border-radius: 0 var(--radius) var(--radius) 0; padding: 20px 24px; text-decoration: none;
    transition: outline-color .15s ease, box-shadow .15s ease;
  }
  .tk__dl:hover { box-shadow: var(--shadow-card); text-decoration: none; }
  .tk__dl--terra { border-left: 3px solid var(--terra); background: var(--terra-tint); }
  .tk__dl--terra:hover { outline-color: var(--terra); }
  .tk__dl--gold { border-left: 3px solid var(--golden); background: rgba(196,150,42,0.07); }
  .tk__dl--gold:hover { outline-color: var(--golden); }
  .tk__dl--midnight { border-left: 3px solid var(--midnight); background: var(--midnight-tint); }
  .tk__dl--midnight:hover { outline-color: var(--midnight); }
  .tk__dl-num {
    width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-family: var(--font-serif); font-weight: 500; font-size: 19px; color: var(--paper);
  }
  .tk__dl--terra .tk__dl-num { background: var(--terra); }
  .tk__dl--gold .tk__dl-num { background: var(--golden); }
  .tk__dl--midnight .tk__dl-num { background: var(--midnight); }
  .tk__dl-name { font-family: var(--font-serif); font-weight: 500; font-size: 19px; color: var(--ink); display: block; }
  .tk__dl-meta { font-family: var(--font-sans); font-weight: 400; font-size: 14px; color: var(--muted); margin-top: 4px; line-height: 1.5; display: block; }
  .tk__dl-action { display: inline-flex; align-items: center; gap: 7px; font-family: var(--font-sans); font-weight: 600; font-size: 13px; letter-spacing: 0.02em; color: var(--ink); border-bottom: 2px solid var(--terra); padding-bottom: 3px; white-space: nowrap; }
  .tk__dl-action svg { display: block; color: var(--terra); }
  @media (max-width: 620px) {
    .tk__dl { grid-template-columns: 44px 1fr; }
    .tk__dl-action { grid-column: 2; }
  }
  .tk__form-done { font-family: var(--font-sans); font-weight: 400; font-size: 16px; color: var(--on-dark); line-height: 1.7; max-width: 480px; margin: 0; }
  .tk-kit-placeholder {
    border: 1px dashed rgba(245,240,230,0.2); border-radius: var(--radius); background: rgba(0,0,0,0.15);
    padding: 14px 18px; margin-top: 24px; max-width: 480px;
    font-family: var(--font-sans); font-size: 12px; font-weight: 400; font-style: italic; color: rgba(245,240,230,0.55);
  }
  @media (max-width: 620px) {
    .tk__piece { grid-template-columns: 44px 1fr; gap: 14px; }
  }
</style>
