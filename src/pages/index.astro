---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "The Geriatrician's Guide — Senior Living Guidance from a Stanford-Trained Geriatrician";
const description = "Clinical clarity for families facing senior living decisions. Free tools, physician-written guidance, and no placement commissions. Ever.";
---
<BaseLayout title={title} description={description}>

  <!-- SECTION 2 — HERO -->
  <section class="hero" data-screen-label="Hero">
    <div class="hero__inner">
      <div class="hero__text">
        <h1>Clear answers for the decisions that matter most.</h1>
        <p class="hero__sub">Geriatrics is the field that asks what matters to you. I trained in it at Stanford, then spent years caring for older adults in their homes and across senior living communities. I built this for the same reason I chose the field: to be useful in the ways that actually matter.</p>
        <div class="hero__cta">
          <a class="btn btn--accent" href="#checklist">Get the Free Tour Checklist
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <span class="hero__secondary"><a href="/products">Learn about The Long Road &rarr;</a></span>
      </div>
      <figure class="hero__figure">
        <div class="hero__media" role="img" aria-label="Hero image placeholder">
          <span class="hero__media-label">Hero image</span>
        </div>
        <figcaption class="hero__caption">Dr. Michael Genualdi, MD &mdash; Board-Certified in Geriatrics and Internal Medicine</figcaption>
      </figure>
    </div>
  </section>

  <!-- SECTION 3 — AUTHORITY BRIDGE -->
  <section class="authority" data-screen-label="Authority bridge">
    <div class="authority__inner">
      <p>Most physicians have never set foot inside a senior living community. I spent years visiting dozens of them &mdash; meeting with the nurses and directors responsible for what actually happened to residents between my visits, reviewing medication lists, learning the prescribing and pharmacy processes well enough to know exactly where they fail. I know what a well-run community looks like from the inside. This is what I built so you can too.</p>
    </div>
  </section>

  <!-- SECTION 4 — LEAD MAGNET -->
  <section class="lead-light" id="checklist" data-screen-label="Lead magnet">
    <div class="lead-light__inner">
      <p class="lead-light__eyebrow">Free Download</p>
      <h2 class="lead-light__headline">The Tour Day Checklist</h2>
      <p class="lead-light__sub">57 things a geriatrician looks for that won&rsquo;t appear on the brochure &mdash; organized the way I&rsquo;d walk a facility myself.</p>

      <div class="proof-row">
        <div class="proof-item">
          <h3>Before you arrive</h3>
          <p>What to look up, what to prepare, and which questions to write down before you schedule anything.</p>
        </div>
        <div class="proof-item">
          <h3>On the tour</h3>
          <p>Medication safety, staffing patterns, memory care, physical environment, dining, contracts.</p>
        </div>
        <div class="proof-item">
          <h3>After you leave</h3>
          <p>How to compare what you saw and what to follow up on before you decide.</p>
        </div>
      </div>

      <!-- BEEHIIV EMBED CODE HERE -->
      <form class="lm-form--light" onsubmit="return false">
        <input type="email" placeholder="you@email.com" aria-label="Email address">
        <button type="submit">Get the checklist</button>
      </form>
      <p class="lead-light__fine">No spam. One resource. Unsubscribe anytime.</p>
    </div>
  </section>

  <!-- SECTION 5 — INDEPENDENCE TRUST BLOCK -->
  <section class="independence" data-screen-label="Independence">
    <div class="independence__inner">
      <div class="independence__rule"></div>
      <p class="independence__quote">No placement commissions. No facility money. No referral fees. Ever.</p>
      <p class="independence__body">I built this because people navigating this decision deserve at least one voice that has nothing to gain from where their loved one ends up.</p>
    </div>
  </section>

  <!-- SECTION 6 — PRODUCT TEASER -->
  <section class="teaser" data-screen-label="Product teaser">
    <div class="teaser__inner">
      <div class="teaser__text">
        <p class="teaser__eyebrow">The Flagship</p>
        <h2 class="teaser__title">The Long Road</h2>
        <p class="teaser__sub">A Geriatrician&rsquo;s Complete Guide to Senior Care Decisions</p>
        <p class="teaser__body">A 200-page reference covering the full arc &mdash; from the first signs of decline through end-of-life decisions. The finances, the tour, the contract, the conversation you&rsquo;ve been avoiding. Written for anyone navigating this for someone they love.</p>
        <a class="btn btn--primary" href="/products">Learn more
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
      <div class="teaser__card" role="img" aria-label="The Long Road — book cover">
        <p class="teaser__card-kicker">The</p>
        <p class="teaser__card-name">Geriatrician&rsquo;s Guide</p>
        <div class="teaser__card-rule"></div>
        <h3 class="teaser__card-title">The Long Road</h3>
        <p class="teaser__card-sub">A Geriatrician&rsquo;s Complete Guide to Senior Care Decisions</p>
      </div>
    </div>
  </section>

</BaseLayout>
</content>
