---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import '../styles/global.css';

const { title, description, noindex, structuredDataType, article } = Astro.props;
// Canonical form has no trailing slash (home stays "/").
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <StructuredData type={structuredDataType} article={article} />

    <link rel="preload" href="/fonts/SourceSans3-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Lora-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <!-- PLAUSIBLE SCRIPT TAG HERE -->

    <!-- Netlify Identity: lets invite/login links open the /admin writing dashboard -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', function (user) {
          if (!user) {
            window.netlifyIdentity.on('login', function () {
              document.location.href = '/admin/';
            });
          }
        });
      }
    </script>

    <slot name="head" />
    <link rel="icon" href="/favicon.ico" />
    <script is:inline src="/assets/email-validate.js" defer></script>
  </head>
  <body>
    <Header />
    <main class="page">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        var t = document.querySelector('.nav-toggle');
        var n = document.querySelector('.site-nav');
        if (t && n) {
          t.addEventListener('click', function () {
            var o = n.classList.toggle('open');
            t.setAttribute('aria-expanded', o);
          });
        }
      })();
    </script>
  </body>
</html>
